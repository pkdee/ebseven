---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Album from '../components/Album.astro';
import About from '../components/About.astro';
import Members from '../components/Members.astro';
import History from '../components/History.astro';
import Gallery from '../components/Gallery.astro';
import Videos from '../components/Videos.astro';
import Fanart from '../components/Fanart.astro';
import Schedule from '../components/Schedule.astro';
