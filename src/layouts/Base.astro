---
import '../styles/global.css';
import SpeedInsights from '@vercel/speed-insights/astro';
import { site, links, members, album } from '../data/site';

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = site.ogImage ? new URL(site.ogImage, Astro.site).href : undefined;

const sameAs = [links.youtube, links.instagram, links.linkpie].filter(Boolean);
const named = members.filter((m) => m.name);

// 검색엔진이 팀 정보를 이해하도록 돕는 구조화 데이터
const home = new URL('/', Astro.site).href;
const abs = (path: string) => new URL(path, Astro.site).href;
const group = {
  '@type': 'MusicGroup',
  '@id': `${home}#band`,
  name: site.name,
  alternateName: site.nameKo,
  genre: ['Funk', 'Jazz'],
  description: site.description,
  url: home,
  logo: abs('/images/logo-original.png'),
  image: site.teamPhotos.map((p) => abs(p.src)),
  location: { '@type': 'Place', name: site.region, address: { '@type': 'PostalAddress', addressLocality: site.region, addressCountry: 'KR' } },
  ...(sameAs.length ? { sameAs } : {}),
  ...(named.length
    ? {
        member: named.map((m) => ({
          '@type': 'OrganizationRole',
          roleName: m.part,
          member: {
            '@type': 'Person',
            name: m.name,
            ...(m.instagram ? { sameAs: [`https://www.instagram.com/${m.instagram}/`] } : {}),
          },
        })),
      }
    : {}),
  album: {
    '@type': 'MusicAlbum',
    name: `${album.title} (${album.titleEn})`,
    datePublished: album.releaseAt.slice(0, 10),
    image: abs(album.cover),
    byArtist: { '@id': `${home}#band` },
  },
};
// 검색 결과에 사이트 이름이 "이플랫세븐" 으로 보이도록 알려 준다
const website = {
  '@type': 'WebSite',
  '@id': `${home}#website`,
  name: site.nameKo,
  alternateName: [site.name, `${site.nameKo} ${site.name}`],
  url: home,
  inLanguage: 'ko-KR',
};
const jsonLd = { '@context': 'https://schema.org', '@graph': [website, group] };
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-64.png" sizes="64x64" type="image/png" />
    {/* 구글 검색 결과 아이콘은 48px 의 배수 크기를 쓴다 */}
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0e6d62" />
    <meta name="color-scheme" content="light" />
    {site.verification.google.map((code) => <meta name="google-site-verification" content={code} />)}
    {site.verification.naver && <meta name="naver-site-verification" content={site.verification.naver} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical.href} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={`${site.nameKo} ${site.name}`} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+KR:wght@400;500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    {/* Vercel 배포 환경에서 실제 방문자의 페이지 속도를 수집한다 */}
    <SpeedInsights />
  </body>
</html>
