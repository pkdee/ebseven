---
import { sound } from '../data/site';
---

<section class="section section--surface" id="sound">
  <div class="container grid">
    <div class="text">
      <div class="section-head">
        <p class="eyebrow">Our Sound</p>
        <h2 class="section-title">{sound.lead}</h2>
      </div>
      {sound.body.map((p) => <p class="body">{p}</p>)}
      {
        sound.collaborators.length > 0 && (
          <div class="collab">
            <p class="label">함께한 보컬 아티스트</p>
            <ul>
              {sound.collaborators.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <div class="songs">
      <p class="label">Song List</p>
      <ol>
        {
          sound.songs.map((s) => (
            <li>
              <b>{s.title}</b>
              <span>{s.artist}</span>
            </li>
          ))
        }
      </ol>
      <p class="more">이 밖에도 행사 분위기에 맞춰 곡을 구성합니다.</p>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .text {
    display: grid;
    gap: 16px;
    max-width: 62ch;
  }
  .section-head {
    margin-bottom: 8px;
  }
  .section-title {
    font-size: var(--step-2);
    line-height: 1.4;
  }
  .body {
    font-size: 1.05rem;
  }
  .label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .collab {
    display: grid;
    gap: 10px;
    margin-top: 12px;
  }
  .collab ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .collab li {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--accent-soft);
    font-weight: 500;
  }

  .songs {
    display: grid;
    gap: 14px;
    padding: clamp(20px, 3vw, 32px);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  li {
    display: grid;
    gap: 2px;
    padding-block: 12px;
    border-top: 1px solid var(--line);
  }
  li b {
    font-size: var(--step-1);
  }
  li span {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .more {
    color: var(--muted);
    font-size: 0.92rem;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
