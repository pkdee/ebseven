---
import SocialIcon from './SocialIcon.astro';
import { site, links, album } from '../data/site';
---

<section class="hero" id="top">
  <div class="container grid">
    <div class="copy">
      <p class="eyebrow">{site.nameKo}</p>
      <h1 class="word">
        <img src="/images/logo-wordmark.png" alt={`${site.name} ${site.nameKo}`} width="749" height="145" fetchpriority="high" />
      </h1>
      <p class="tagline">{site.heroTagline}</p>
      <ul class="scenes" aria-label="주요 공연 현장">
        {site.scenes.map((s) => <li>{s}</li>)}
      </ul>
      <nav class="quick" aria-label="바로가기">
        {
          links.youtube && (
            <a href={links.youtube} target="_blank" rel="noopener" aria-label="유튜브 채널" title="YouTube">
              <SocialIcon name="youtube" size={26} />
            </a>
          )
        }
        {
          links.instagram && (
            <a href={links.instagram} target="_blank" rel="noopener" aria-label="인스타그램" title="Instagram">
              <SocialIcon name="instagram" size={24} />
            </a>
          )
        }
        <a class="album" href="#album" aria-label={`${album.label} ${album.title} 듣기`} title={`${album.label} ${album.title}`}>
          <img src={album.cover} alt="" width="28" height="28" />
          <span class="dday" data-hero-dday={album.releaseAt} hidden></span>
        </a>
      </nav>
    </div>

    <div class="photo slider" data-slider data-autoplay="5000" aria-roledescription="carousel" aria-label="단체 사진">
      <div class:list={['stage', { single: site.teamPhotos.length < 2 }]}>
        {/* 사진 뒤에 다음 사진을 흐리게 깔아, 카드가 겹쳐 있는 것처럼 보이게 한다 */}
        {
          site.teamPhotos.length > 1 && (
            <div class="peek" aria-hidden="true">
              <img data-peek src={site.teamPhotos[1].src} alt="" width="1200" height="1200" decoding="async" />
            </div>
          )
        }
        <div class="track" data-track tabindex="0">
          {
            site.teamPhotos.map((p, i) => (
              <figure class="slide">
                <img
                  src={p.src}
                  alt={p.alt}
                  width="1200"
                  height="1200"
                  fetchpriority={i === 0 ? 'high' : 'low'}
                  decoding="async"
                />
              </figure>
            ))
          }
        </div>
      </div>

      <div class="slider-controls">
        <button class="slider-nav" type="button" data-prev aria-label="이전 사진">
          <span aria-hidden="true">‹</span>
        </button>
        <div class="slider-dots" data-dots role="group" aria-label="사진 페이지"></div>
        <button class="slider-nav" type="button" data-next aria-label="다음 사진">
          <span aria-hidden="true">›</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import { initSliders } from '../scripts/slider';
  initSliders();

  // 뒤에 깔린 흐린 사진은 항상 지금 사진의 다음 장을 보여 준다
  const heroTrack = document.querySelector<HTMLElement>('.hero [data-track]');
  const peek = document.querySelector<HTMLImageElement>('.hero [data-peek]');
  if (heroTrack && peek) {
    const srcs = Array.from(heroTrack.querySelectorAll('img')).map((img) => img.currentSrc || img.src);
    let shown = -1;
    let fade = 0;
    const sync = () => {
      const i = Math.round(heroTrack.scrollLeft / Math.max(1, heroTrack.clientWidth));
      const next = (i + 1) % srcs.length;
      if (next === shown) return;
      const first = shown === -1;
      shown = next;
      window.clearTimeout(fade);
      if (first) {
        peek.src = srcs[next];
        return;
      }
      peek.classList.add('swap');
      fade = window.setTimeout(() => {
        peek.src = srcs[next];
        peek.classList.remove('swap');
      }, 180);
    };
    heroTrack.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    sync();
  }

  // 앨범 아이콘 배지: 발매 전에는 D-n, 당일은 D-DAY, 발매 후에는 NEW (한국 시간 기준 날짜)
  document.querySelectorAll<HTMLElement>('[data-hero-dday]').forEach((el) => {
    const at = new Date(el.dataset.heroDday!).getTime();
    if (Number.isNaN(at)) return;
    const kstDay = (t: number) => Date.parse(new Date(t + 9 * 3600 * 1000).toISOString().slice(0, 10));
    const now = Date.now();
    const days = Math.round((kstDay(at) - kstDay(now)) / 86400000);
    el.textContent = now >= at ? 'NEW' : days > 0 ? `D-${days}` : 'D-DAY';
    el.hidden = false;
  });
</script>

<style>
  .hero {
    background: var(--hero-bg);
    color: var(--hero-ink);
    padding-block: clamp(48px, 8vw, 104px) clamp(56px, 8vw, 104px);
    overflow: hidden;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(36px, 6vw, 72px);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 20px;
    min-width: 0;
  }
  .eyebrow {
    color: var(--hero-accent);
  }
  .word {
    line-height: 0;
  }
  .word img {
    width: min(100%, 520px);
    height: auto;
  }
  .tagline {
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.4;
  }
  .scenes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .scenes li {
    font-size: var(--step--1);
    color: var(--hero-muted);
    border: 1px solid var(--hero-line);
    border-radius: 999px;
    padding: 4px 12px;
  }

  .quick {
    display: flex;
    gap: 10px;
    margin-top: 4px;
  }
  .quick a {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .quick a:hover {
    transform: translate(-1px, -1px);
    border-color: var(--brand-shadow);
    box-shadow: 3px 3px 0 var(--brand-shadow);
  }
  .quick .album {
    position: relative;
  }
  .dday {
    position: absolute;
    top: -9px;
    right: -12px;
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--brand-yellow);
    color: var(--brand-shadow);
    box-shadow: 2px 2px 0 var(--brand-shadow);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    line-height: 1.5;
    white-space: nowrap;
    pointer-events: none;
  }
  .dday[hidden] {
    display: none;
  }
  .quick .album img {
    width: 28px;
    height: 28px;
    border-radius: 4px;
    object-fit: cover;
  }

  /* 단체 사진 슬라이드. 사진 뒤 오른쪽 아래로 다음 사진이 흐리게 겹쳐 보인다 */
  .photo {
    --peek: clamp(14px, 2.2vw, 24px);
    min-width: 0;
    padding: 0 var(--peek) 0 0;
  }
  .stage {
    position: relative;
    isolation: isolate;
    margin-bottom: var(--peek);
  }
  .photo .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    border-radius: var(--radius);
  }
  /* 사진이 한 장뿐이면 예전처럼 검은 그림자 */
  .stage.single .track {
    box-shadow: 10px 10px 0 var(--brand-shadow);
  }
  .peek {
    position: absolute;
    inset: 0;
    z-index: -1;
    transform: translate(var(--peek), var(--peek));
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--brand-shadow);
    box-shadow: 0 10px 24px rgba(1, 11, 9, 0.18);
  }
  .peek img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 가장자리가 흐려져 비지 않도록 조금 키운다 */
    transform: scale(1.06);
    filter: blur(3px) brightness(0.88);
    transition: opacity 0.18s ease;
  }
  .peek img.swap {
    opacity: 0;
  }
  .photo .slide {
    margin: 0;
  }
  .photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .photo .slider-controls {
    margin-top: 6px;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .photo {
      order: -1;
      max-width: 560px;
    }
  }
</style>
