---
import { about } from '../data/site';
---

<section class="section section--surface" id="about">
  <div class="container grid">
    <div class="section-head">
      <p class="eyebrow">About</p>
      <h2 class="section-title">{about.lead}</h2>
    </div>
    <div class="body">
      {about.body.map((p) => <p>{p}</p>)}
      <aside class="name">
        <span class="symbol" aria-hidden="true">E♭7</span>
        <p>{about.nameStory}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(24px, 6vw, 96px);
    align-items: start;
  }
  .section-head {
    margin-bottom: 0;
  }
  .body {
    display: grid;
    gap: 18px;
    font-size: 1.05rem;
    max-width: 62ch;
  }
  .name {
    margin-top: 12px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    align-items: center;
    padding: 20px 22px;
    background: var(--accent-soft);
    border-radius: var(--radius);
    font-size: 0.98rem;
  }
  .symbol {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1.6rem;
    color: var(--accent);
    line-height: 1;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
