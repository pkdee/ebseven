---
import { members } from '../data/site';

const heading = '하나의 음악을 만드는 밴드';
---

<section class="section" id="members">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Members</p>
      <h2 class="section-title">{heading}</h2>
      <p class="section-desc">각자의 소리가 겹쳐 이플랫세븐의 무대가 됩니다.</p>
    </div>

    <ul class="grid">
      {
        members.map((m, i) => {
          const name = m.name || `멤버 ${i + 1}`;
          return (
            <li class="card">
              <div class="photo">
                {m.photo ? (
                  <img src={m.photo} alt={`${m.part} ${name}`} loading="lazy" width="800" height="1000" />
                ) : (
                  <span class="ph" aria-hidden="true">
                    {m.name ? m.name.slice(0, 1) : String(i + 1).padStart(2, '0')}
                  </span>
                )}
              </div>
              <div class="info">
                <p class:list={['part', { empty: !m.part }]} data-fit>
                  {m.part || '파트 입력 전'}
                  {m.partEn && <span class="part-en">({m.partEn})</span>}
                </p>
                <h3>
                  {name}
                  {m.nameEn && <span class="name-en">{m.nameEn}</span>}
                </h3>
                {m.intro && <p class="intro">{m.intro}</p>}
                {m.career && <p class="career">{m.career}</p>}
                {m.instagram && (
                  <a class="ig" href={`https://www.instagram.com/${m.instagram}`} target="_blank" rel="noopener">
                    @{m.instagram}
                  </a>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  // 파트 이름(한국어 + 영문)이 한 줄에 들어가도록 글자 크기를 줄인다.
  // 카드마다 크기가 달라 보이지 않게, 가장 긴 것에 맞춘 크기를 모든 카드에 똑같이 쓴다.
  const parts = Array.from(document.querySelectorAll<HTMLElement>('#members [data-fit]'));
  const MAX = 13;
  const MIN = 9;
  const fit = () => {
    let size = MAX;
    parts.forEach((p) => (p.style.fontSize = `${MAX}px`));
    for (const p of parts) {
      p.style.fontSize = `${size}px`;
      while (size > MIN && p.scrollWidth > p.clientWidth) {
        size -= 0.5;
        p.style.fontSize = `${size}px`;
      }
    }
    parts.forEach((p) => (p.style.fontSize = `${size}px`));
  };
  if (parts.length) {
    document.fonts?.ready.then(fit);
    fit();
    let t = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(t);
      t = window.setTimeout(fit, 100);
    });
  }
</script>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 24px);
  }
  .card {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .photo {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    background: linear-gradient(160deg, var(--surface), var(--line));
    display: grid;
    place-items: center;
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    transition: transform 0.4s ease;
  }
  .card:hover .photo img {
    transform: scale(1.03);
  }
  .ph {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 3.2rem);
    color: var(--muted);
    opacity: 0.6;
  }
  .info {
    display: grid;
    gap: 2px;
  }
  /* 한국어 오른쪽에 영문. 한 줄을 유지하고, 넘치면 스크립트가 글자 크기를 줄인다 */
  .part {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--accent);
    white-space: nowrap;
    overflow: hidden;
  }
  .part-en {
    margin-left: 0.35em;
    color: var(--muted);
    font-weight: 400;
  }
  .part.empty {
    color: var(--muted);
  }
  h3 {
    font-size: var(--step-1);
    font-weight: 700;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 8px;
  }
  .name-en {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--muted);
  }
  .intro {
    color: var(--ink);
    font-size: 0.95rem;
  }
  .career {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .ig {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    text-underline-offset: 3px;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
