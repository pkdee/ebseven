---
import { members } from '../data/site';

const counts = ['', '한', '두', '세', '네', '다섯', '여섯', '일곱', '여덟', '아홉', '열'];
const heading = counts[members.length] ? `${counts[members.length]} 명의 연주자` : '연주자';
---

<section class="section" id="members">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Members</p>
      <h2 class="section-title">{heading}</h2>
      <p class="section-desc">각자의 악기로 하나의 화음을 만듭니다.</p>
    </div>

    <ul class="grid">
      {
        members.map((m, i) => {
          const name = m.name || `멤버 ${i + 1}`;
          return (
            <li class="card">
              <div class="photo">
                {m.photo ? (
                  <img src={m.photo} alt={`${m.part} ${name}`} loading="lazy" width="800" height="1093" />
                ) : (
                  <span class="ph" aria-hidden="true">
                    {m.name ? m.name.slice(0, 1) : String(i + 1).padStart(2, '0')}
                  </span>
                )}
                {m.role && <span class="role">{m.role}</span>}
              </div>
              <div class="info">
                <p class:list={['part', { empty: !m.part }]}>{m.part || '파트 입력 전'}</p>
                <h3>{name}</h3>
                {m.intro && <p class="intro">{m.intro}</p>}
                {m.career && <p class="career">{m.career}</p>}
                {m.instagram && (
                  <a class="ig" href={`https://www.instagram.com/${m.instagram}`} target="_blank" rel="noopener">
                    @{m.instagram}
                  </a>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 24px);
  }
  .card {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .photo {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    background: linear-gradient(160deg, var(--surface), var(--line));
    display: grid;
    place-items: center;
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    transition: transform 0.4s ease;
  }
  .card:hover .photo img {
    transform: scale(1.03);
  }
  .ph {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 3.2rem);
    color: var(--muted);
    opacity: 0.6;
  }
  .role {
    position: absolute;
    left: 10px;
    top: 10px;
    font-size: var(--step--1);
    font-weight: 600;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--brand-yellow);
    color: var(--brand-shadow);
    box-shadow: 2px 2px 0 var(--brand-shadow);
  }
  .info {
    display: grid;
    gap: 2px;
  }
  .part {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  .part.empty {
    color: var(--muted);
  }
  h3 {
    font-size: var(--step-1);
    font-weight: 700;
  }
  .intro {
    color: var(--ink);
    font-size: 0.95rem;
  }
  .career {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .ig {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    text-underline-offset: 3px;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
