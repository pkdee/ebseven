---
import { shows } from '../data/site';

const nav = [
  { href: '#about', label: '소개' },
  { href: '#members', label: '멤버' },
  { href: '#sound', label: '사운드' },
  { href: '#history', label: '이력' },
  { href: '#videos', label: '영상' },
  // 등록된 공연이 없으면 일정 섹션이 숨겨지므로 메뉴에서도 뺀다.
  ...(shows.length ? [{ href: '#schedule', label: '일정' }] : []),
];
---

<header class="header">
  <div class="container bar">
    <a class="logo" href="#top" aria-label="ebseven 처음으로">
      <img src="/images/logo-wordmark.png" alt="" width="749" height="145" />
    </a>

    <nav class="nav" aria-label="주요 메뉴">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>

    <a class="btn btn--brand cta" href="#booking">섭외 문의</a>

    <details class="menu">
      <summary aria-label="메뉴 열기">
        <span></span><span></span>
      </summary>
      <nav aria-label="모바일 메뉴">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href="#booking">섭외 문의</a>
      </nav>
    </details>
  </div>
</header>

<script>
  // 모바일 메뉴에서 항목을 누르면 메뉴를 닫는다.
  document.querySelectorAll<HTMLAnchorElement>('.menu nav a').forEach((a) => {
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open'));
  });
</script>

<style>
  .header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: color-mix(in srgb, var(--header-bg) 94%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--header-ink);
    border-bottom: 1px solid var(--header-line);
  }
  :global(body)::before {
    content: '';
    position: fixed;
    inset: 0 0 auto;
    height: env(safe-area-inset-top, 0px);
    z-index: 30;
    background: var(--header-bg);
  }
  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .logo {
    display: block;
    flex: none;
  }
  .logo img {
    height: 26px;
    width: auto;
  }
  .nav {
    display: flex;
    gap: 22px;
    margin-left: auto;
    font-size: 0.95rem;
  }
  .nav a {
    text-decoration: none;
    color: var(--header-muted);
  }
  .nav a:hover {
    color: var(--header-ink);
  }
  .cta {
    min-height: 38px;
    padding: 0 16px;
    font-size: 0.9rem;
  }
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
    cursor: pointer;
    width: 40px;
    height: 40px;
    display: grid;
    place-content: center;
    gap: 6px;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary span {
    display: block;
    width: 20px;
    height: 2px;
    background: currentColor;
    transition: transform 0.2s ease;
  }
  .menu[open] summary span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .menu[open] summary span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
  .menu nav {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    min-width: 180px;
    display: grid;
    padding: 8px;
    background: var(--header-bg);
    border: 1px solid var(--header-line);
    border-radius: var(--radius);
  }
  .menu nav a {
    padding: 10px 14px;
    text-decoration: none;
    border-radius: 8px;
  }
  .menu nav a:hover {
    background: var(--header-line);
  }

  @media (max-width: 760px) {
    .nav {
      display: none;
    }
    .cta {
      margin-left: auto;
    }
    .menu {
      display: block;
    }
  }
</style>
