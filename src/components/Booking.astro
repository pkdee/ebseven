---
import SocialIcon from './SocialIcon.astro';
import { booking, links } from '../data/site';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const isDev = import.meta.env.DEV;
// 운영 배포에서 키가 없으면 제출해도 아무 데도 가지 않으므로 폼을 숨긴다.
const showForm = Boolean(accessKey) || isDev;
const details = booking.details.filter((d) => d.value);

const quick = [
  links.phone && {
    label: links.phoneOwner || '전화',
    value: links.phone,
    href: `tel:${links.phone.replaceAll('-', '')}`,
  },
  links.instagram && {
    label: '인스타그램 DM',
    value: `@${links.instagramId}`,
    href: links.instagram,
    icon: 'instagram',
  },
  links.email && { label: '메일', value: links.email, href: `mailto:${links.email}` },
  links.kakao && { label: '카카오톡', value: '채널로 문의하기', href: links.kakao },
].filter(Boolean) as { label: string; value: string; href: string; icon?: 'instagram' | 'youtube' }[];
---

<section class="section" id="booking">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Booking</p>
      <h2 class="section-title">공연 섭외 및 문의</h2>
      <p class="section-desc">{booking.intro} 아래 양식을 남겨 주시면 확인 후 연락드립니다.</p>
    </div>

    <div class="layout">
      <div class="side">
        <p class="quick-title formats-title">이런 무대를 함께 만듭니다</p>
        <ul class="formats">
          {
            booking.formats.map((f) => (
              <li>
                <span class="en">{f.en}</span>
                <b>{f.ko}</b>
              </li>
            ))
          }
        </ul>

        {
          details.length > 0 && (
            <dl class="details">
              {details.map((d) => (
                <div>
                  <dt>{d.label}</dt>
                  <dd>{d.value}</dd>
                </div>
              ))}
            </dl>
          )
        }

        {
          quick.length > 0 && (
            <div class="quick">
              <p class="quick-title">바로 연락하기</p>
              {quick.map((q) => (
                <a href={q.href} target={q.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                  <span>{q.label}</span>
                  <em class="val">
                    {q.icon && <SocialIcon name={q.icon} size={18} />}
                    {q.value}
                  </em>
                </a>
              ))}
            </div>
          )
        }
      </div>

      {
        showForm ? (
          <form class="form" id="booking-form" novalidate>
            {isDev && !accessKey && (
              <p class="dev-note">
                개발용 안내: .env 에 PUBLIC_WEB3FORMS_KEY 가 없어서 지금은 제출해도 전송되지 않습니다. 키가 없는 채로
                배포하면 이 폼은 숨겨집니다.
              </p>
            )}
            <input type="hidden" name="access_key" value={accessKey} />
            <input type="hidden" name="subject" value="[ebseven] 새 공연 섭외 문의" />
            <input type="hidden" name="from_name" value="ebseven 홈페이지" />
            <input type="checkbox" name="botcheck" style="display: none" tabindex="-1" autocomplete="off" />

            <fieldset>
              <legend>담당자 정보</legend>
              <div class="row">
                <label>
                  <span>담당자 이름 <em>필수</em></span>
                  <input id="f-name" name="담당자" required autocomplete="name" />
                </label>
                <label>
                  <span>소속 (기관·업체명) <em>필수</em></span>
                  <input id="f-org" name="소속" required autocomplete="organization" />
                </label>
              </div>
              <div class="row">
                <label>
                  <span>연락처 <em>필수</em></span>
                  <input id="f-phone" name="연락처" type="tel" required autocomplete="tel" placeholder="010-0000-0000" />
                </label>
                <label>
                  <span>이메일</span>
                  <input id="f-email" name="email" type="email" autocomplete="email" />
                </label>
              </div>
            </fieldset>

            <fieldset>
              <legend>행사 정보</legend>
              <label>
                <span>행사명 <em>필수</em></span>
                <input id="f-event" name="행사명" required />
              </label>
              <div class="row">
                <label>
                  <span>행사 날짜 <em>필수</em></span>
                  <input id="f-date" name="행사 날짜" type="date" required />
                </label>
                <label>
                  <span>행사 장소 (지역) <em>필수</em></span>
                  <input id="f-place" name="행사 장소" required placeholder="예: ○○시 ○○광장" />
                </label>
              </div>
              <div class="row">
                <label>
                  <span>희망 공연 형태 <em>필수</em></span>
                  <select id="f-format" name="공연 형태" required>
                    <option value="">선택해 주세요</option>
                    {booking.formats.map((f) => <option>{f.ko}</option>)}
                    <option>아직 정하지 않음</option>
                  </select>
                </label>
                <label>
                  <span>희망 공연 시간</span>
                  <input id="f-duration" name="공연 시간" placeholder="예: 40분, 2부 구성" />
                </label>
              </div>
              <div class="row">
                <label>
                  <span>예상 관객 규모</span>
                  <select id="f-audience" name="관객 규모">
                    <option value="">선택 안 함</option>
                    <option>50명 이하</option>
                    <option>50~200명</option>
                    <option>200~500명</option>
                    <option>500명 이상</option>
                  </select>
                </label>
                <label>
                  <span>현장 음향 장비</span>
                  <select id="f-sound" name="음향 장비">
                    <option value="">선택 안 함</option>
                    <option>현장에 있음</option>
                    <option>없음</option>
                    <option>모름</option>
                  </select>
                </label>
              </div>
              <label>
                <span>예산 범위</span>
                <input id="f-budget" name="예산" placeholder="대략적인 범위를 적어 주시면 편성 제안에 도움이 됩니다" />
              </label>
              <label>
                <span>기타 요청 사항</span>
                <textarea id="f-message" name="요청 사항" rows="4" placeholder="행사 분위기, 원하는 곡 장르, 보컬 동반 여부 등"></textarea>
              </label>
            </fieldset>

            <label class="consent">
              <input id="f-consent" type="checkbox" name="개인정보 동의" value="동의함" required />
              <span>
                <b>개인정보 수집·이용에 동의합니다 (필수)</b>
                수집 항목: 이름, 소속, 연락처, 이메일 · 목적: 공연 섭외 상담 · 보관 기간: 상담 종료 후 1년
              </span>
            </label>

            <button class="btn btn--primary submit" type="submit">문의 보내기</button>
            <p class="status" role="status" aria-live="polite"></p>
          </form>
        ) : (
          <div class="pending">
            <b>문의 양식을 준비하고 있습니다</b>
            {links.email ? (
              <span>
                지금은 <a href={`mailto:${links.email}`}>{links.email}</a> 로 연락 주세요.
              </span>
            ) : (
              <span>곧 연락 창구가 열립니다.</span>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector<HTMLParagraphElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('.submit')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.className = 'status';

      if (!form.checkValidity()) {
        const first = form.querySelector<HTMLElement>(':invalid');
        first?.focus();
        status.textContent = '필수 항목을 모두 입력하고 개인정보 수집에 동의해 주세요.';
        status.classList.add('err');
        return;
      }

      const data = Object.fromEntries(new FormData(form).entries());
      if (!data.access_key) {
        status.textContent = '문의 폼이 아직 연결되지 않았습니다. 관리자에게 알려 주세요.';
        status.classList.add('err');
        return;
      }

      button.disabled = true;
      button.textContent = '보내는 중';
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (!res.ok || !json.success) throw new Error(json.message || 'failed');
        form.reset();
        status.textContent = '문의가 접수되었습니다. 확인 후 남겨 주신 연락처로 연락드리겠습니다.';
        status.classList.add('ok');
      } catch {
        status.textContent = '전송하지 못했습니다. 잠시 후 다시 시도하거나 메일로 연락 주세요.';
        status.classList.add('err');
      } finally {
        button.disabled = false;
        button.textContent = '문의 보내기';
      }
    });
  }
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .side {
    display: grid;
    gap: 28px;
  }
  .formats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .formats {
    gap: 0;
    margin-top: -16px;
  }
  .formats li {
    display: grid;
    gap: 2px;
    padding-block: 14px;
    border-top: 1px solid var(--line);
  }
  .formats li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .formats b {
    font-size: 1.05rem;
    font-weight: 600;
  }
  .en {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--accent);
  }
  .details {
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .details div {
    display: grid;
    grid-template-columns: 6.5em 1fr;
    gap: 14px;
  }
  .details dt {
    color: var(--muted);
  }
  .details dd {
    margin: 0;
    min-width: 0;
  }
  .quick {
    display: grid;
    gap: 8px;
  }
  .quick-title {
    font-weight: 600;
  }
  .quick a {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }
  .quick .val {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-style: normal;
    font-size: inherit;
    color: inherit;
    margin: 0;
  }
  .quick a span {
    font-family: var(--font-body);
    color: var(--muted);
    width: 7.5em;
    flex: none;
  }

  .form {
    display: grid;
    gap: 22px;
    padding: clamp(20px, 3vw, 32px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
    min-width: 0;
  }
  legend {
    font-weight: 700;
    margin-bottom: 4px;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  label {
    display: grid;
    gap: 6px;
    min-width: 0;
  }
  label > span {
    font-size: 0.9rem;
    color: var(--muted);
  }
  em {
    font-style: normal;
    font-size: 0.75rem;
    color: var(--accent);
    margin-left: 4px;
  }
  input,
  select,
  textarea {
    width: 100%;
    min-height: 46px;
    padding: 10px 12px;
    font: inherit;
    font-size: 16px;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  textarea {
    resize: vertical;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 0;
    border-color: transparent;
  }
  .consent {
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 12px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .consent input {
    width: 20px;
    min-height: 20px;
    height: 20px;
    margin-top: 2px;
    accent-color: var(--accent);
  }
  .consent span {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .consent b {
    display: block;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .submit {
    justify-self: start;
    min-width: 160px;
  }
  .submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .status {
    font-size: 0.92rem;
    min-height: 1.5em;
  }
  .status.ok {
    color: var(--ok);
  }
  .status.err {
    color: var(--err);
  }
  .dev-note {
    font-size: 0.85rem;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--accent-soft);
  }
  .pending a {
    color: var(--accent);
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
    }
    .submit {
      justify-self: stretch;
    }
  }
</style>
