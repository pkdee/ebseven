---
import { booking } from '../data/site';
---

<section class="section" id="booking">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Booking</p>
      {/* 제목 오른쪽 버튼. data-soon 이 붙어 있어 누르면 섭외 문의 창(SoonDialog)이 열린다 */}
      <div class="head-row">
        <h2 class="section-title">공연 섭외 및 문의</h2>
        <a class="btn btn--brand inquiry" href="#booking" data-soon>문의하기</a>
      </div>
      <p class="section-desc">{booking.intro}</p>
    </div>

    <p class="title">이런 무대를 함께 만듭니다</p>
    <ul class="formats">
      {
        booking.formats.map((f) => (
          <li>
            <span class="en">{f.en}</span>
            <b>{f.ko}</b>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
  }
  /* 헤더의 문의하기 버튼과 같은 크기로 작게 둔다 */
  .inquiry {
    min-height: 38px;
    padding: 0 16px;
    font-size: 0.9rem;
  }
  .title {
    font-weight: 600;
    margin-bottom: 8px;
  }
  .formats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .formats li {
    display: grid;
    gap: 2px;
    padding-block: 14px;
    border-top: 1px solid var(--line);
  }
  .formats li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .formats b {
    font-size: 1.05rem;
    font-weight: 600;
  }
  .en {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--accent);
  }
</style>
