---
import { album, site } from '../data/site';
---

<section class="section album-section" id="album">
  <div class="container grid">
    {/* 티저 쇼츠. 썸네일만 먼저 보여 주고, 누르면 그 자리에서 유튜브 플레이어를 불러온다 */}
    <div class="player">
      <button class="teaser" type="button" data-teaser={album.teaser.youtubeId} aria-label={`${album.teaser.title} 재생`}>
        <img
          src={`https://i.ytimg.com/vi/${album.teaser.youtubeId}/oar2.jpg`}
          alt={`${album.label} ${album.title}(${album.titleEn}) 티저 영상`}
          width="1080"
          height="1920"
          loading="lazy"
          decoding="async"
        />
        <span class="state" aria-hidden="true"><span class="icon-play"></span></span>
      </button>
    </div>

    <div class="info">
      <p class="eyebrow">New Release</p>
      <p class="label">{site.nameKo} {album.label}</p>
      <h2 class="title">
        {album.title}
        <span>{album.titleEn}</span>
      </h2>
      <p class="release">
        <span class="dday" data-release={album.releaseAt} hidden></span>
        {album.releaseText}
      </p>

      {/* 발매 시각까지 남은 시간. 발매 후에는 숨겨진다. */}
      <div class="countdown" data-countdown={album.releaseAt} aria-label="발매까지 남은 시간">
        <p class="cd-label">발매까지</p>
        <ol class="cd-units">
          <li><b data-unit="d">--</b><span>일</span></li>
          <li><b data-unit="h">--</b><span>시간</span></li>
          <li><b data-unit="m">--</b><span>분</span></li>
          <li><b data-unit="s">--</b><span>초</span></li>
        </ol>
      </div>
      <p class="hint">티저 영상을 눌러 피어나를 먼저 만나 보세요.</p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-teaser]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.teaser}?autoplay=1&rel=0&playsinline=1`;
      iframe.title = btn.getAttribute('aria-label')?.replace(/ 재생$/, '') ?? '티저 영상';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
    });
  });

  // 발매 시각까지 1초마다 남은 시간을 보여준다. 시각이 지나면 카운트다운을 숨긴다.
  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((box) => {
    const at = new Date(box.dataset.countdown!).getTime();
    if (Number.isNaN(at)) return;
    const unit = (k: string) => box.querySelector<HTMLElement>(`[data-unit="${k}"]`)!;
    const pad = (n: number) => String(n).padStart(2, '0');
    let timer = 0;
    const tick = () => {
      const left = at - Date.now();
      if (left <= 0) {
        box.hidden = true;
        window.clearInterval(timer);
        document.querySelectorAll<HTMLElement>('[data-release]').forEach((el) => (el.textContent = 'OUT NOW'));
        return;
      }
      const sec = Math.floor(left / 1000);
      unit('d').textContent = String(Math.floor(sec / 86400));
      unit('h').textContent = pad(Math.floor((sec % 86400) / 3600));
      unit('m').textContent = pad(Math.floor((sec % 3600) / 60));
      unit('s').textContent = pad(sec % 60);
    };
    tick();
    timer = window.setInterval(tick, 1000);
  });

  // 발매 전에는 D-n, 당일은 D-DAY, 이후에는 OUT NOW
  document.querySelectorAll<HTMLElement>('[data-release]').forEach((el) => {
    const at = new Date(el.dataset.release!).getTime();
    if (Number.isNaN(at)) return;
    const kst = (t: number) => new Date(t + 9 * 3600 * 1000).toISOString().slice(0, 10);
    const now = Date.now();
    const days = Math.round((Date.parse(kst(at)) - Date.parse(kst(now))) / 86400000);
    el.textContent = now >= at ? 'OUT NOW' : days > 0 ? `D-${days}` : 'D-DAY';
    el.hidden = false;
  });
</script>

<style>
  /* 새 앨범 소식이라 연한 노랑 띠로 구분한다 */
  .album-section {
    background: var(--accent-soft);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  /* 세로 영상이라 너무 길어지지 않게 폭을 줄인다 */
  .player {
    min-width: 0;
    width: 100%;
    max-width: 340px;
    justify-self: center;
    padding-right: 10px;
  }
  .teaser,
  .player :global(iframe) {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    border: 0;
    border-radius: var(--radius);
    background: var(--brand-shadow);
    box-shadow: 10px 10px 0 var(--brand-shadow);
  }
  .teaser {
    position: relative;
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease;
  }
  .teaser:hover {
    transform: translate(-2px, -2px);
  }
  .teaser img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .state {
    position: absolute;
    right: 18px;
    bottom: 18px;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--brand-yellow);
    box-shadow: 3px 3px 0 var(--brand-shadow);
    display: grid;
    place-items: center;
    transition: transform 0.2s ease;
  }
  .teaser:hover .state {
    transform: scale(1.06);
  }
  .icon-play {
    margin-left: 6px;
    border-left: 24px solid var(--brand-shadow);
    border-top: 15px solid transparent;
    border-bottom: 15px solid transparent;
  }

  .info {
    display: grid;
    gap: 10px;
    min-width: 0;
  }
  .label {
    font-weight: 600;
    color: var(--muted);
  }
  .title {
    font-size: clamp(2.6rem, 1.6rem + 4vw, 4.4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    display: grid;
    gap: 6px;
  }
  .title span {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.42em;
    letter-spacing: 0.02em;
    color: var(--accent);
  }
  .release {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: var(--step-1);
    font-weight: 600;
    margin-top: 10px;
  }
  .dday {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--brand-yellow);
    color: var(--brand-shadow);
    box-shadow: 2px 2px 0 var(--brand-shadow);
  }
  .dday[hidden] {
    display: none;
  }
  .hint {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .countdown {
    display: grid;
    gap: 8px;
    margin-block: 8px 4px;
  }
  .countdown[hidden] {
    display: none;
  }
  .cd-label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .cd-units {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cd-units li {
    display: grid;
    justify-items: center;
    gap: 2px;
    min-width: 72px;
    padding: 12px 10px 10px;
    background: var(--bg);
    border: 2px solid var(--brand-shadow);
    border-radius: 12px;
    box-shadow: 3px 3px 0 var(--brand-shadow);
  }
  .cd-units b {
    font-family: var(--font-mono);
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.2rem);
    font-weight: 500;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .cd-units span {
    font-size: var(--step--1);
    color: var(--muted);
  }
  @media (max-width: 400px) {
    .cd-units {
      gap: 8px;
    }
    .cd-units li {
      min-width: 0;
      flex: 1;
    }
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .player {
      max-width: 300px;
    }
  }
</style>
