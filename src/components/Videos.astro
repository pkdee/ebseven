---
import SocialIcon from './SocialIcon.astro';
import { videos, links } from '../data/site';
---

<section class="section section--surface" id="videos">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Live</p>
      <h2 class="section-title">공연 영상</h2>
    </div>

    {
      videos.length === 0 ? (
        <div class="pending">
          <b>공연 영상을 준비하고 있습니다</b>
          {links.youtube && (
            <a class="yt-link" href={links.youtube} target="_blank" rel="noopener">
              <SocialIcon name="youtube" size={22} />
              유튜브 채널 바로가기
            </a>
          )}
        </div>
      ) : (
        <div class="grid">
          {videos.map((v, i) => (
            <figure class:list={['video', { main: i === 0 }]}>
              {/* 썸네일만 먼저 보여주고, 누르면 그때 유튜브 플레이어를 불러온다. */}
              <button class="yt" type="button" data-id={v.youtubeId} aria-label={`${v.title} 재생`}>
                <img
                  src={`https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg`}
                  alt=""
                  loading="lazy"
                  width="480"
                  height="360"
                />
                <span class="play" aria-hidden="true" />
              </button>
              <figcaption>
                {v.title}
                {v.with && <span class="with">with {v.with}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }

    {
      links.youtube && videos.length > 0 && (
        <p class="more">
          <a class="btn btn--ghost yt-link" href={links.youtube} target="_blank" rel="noopener">
            <SocialIcon name="youtube" size={22} />
            유튜브에서 더 보기
          </a>
        </p>
      )
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.yt').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.id;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = btn.getAttribute('aria-label') ?? '유튜브 영상';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
    });
  });
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 2.4vw, 28px) clamp(16px, 2.4vw, 28px);
  }
  .video {
    margin: 0;
    display: grid;
    gap: 10px;
    min-width: 0;
  }
  .video.main {
    grid-column: 1 / -1;
  }
  .yt,
  .video :global(iframe) {
    aspect-ratio: 16 / 9;
    width: 100%;
    max-width: 100%;
    border: 0;
    border-radius: var(--radius);
    overflow: hidden;
    display: block;
  }
  .yt {
    position: relative;
    padding: 0;
    cursor: pointer;
    background: var(--brand-shadow);
  }
  .yt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }
  .yt:hover img {
    opacity: 1;
  }
  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: var(--brand-yellow);
    box-shadow: 3px 3px 0 var(--brand-shadow);
  }
  .play::after {
    content: '';
    position: absolute;
    left: 27px;
    top: 22px;
    border-left: 20px solid var(--brand-shadow);
    border-top: 12px solid transparent;
    border-bottom: 12px solid transparent;
  }
  figcaption {
    font-weight: 500;
    display: grid;
    gap: 2px;
  }
  .with {
    font-weight: 400;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .more {
    margin-top: 28px;
  }
  .yt-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .pending a {
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
