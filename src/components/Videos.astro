---
import SocialIcon from './SocialIcon.astro';
import VideoCard from './VideoCard.astro';
import { videos, shorts, links } from '../data/site';

const [main, ...rest] = videos;
---

<section class="section section--surface" id="videos">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Live</p>
      <h2 class="section-title">공연 영상</h2>
    </div>

    {
      !main ? (
        <div class="pending">
          <b>공연 영상을 준비하고 있습니다</b>
          {links.youtube && (
            <a class="yt-link" href={links.youtube} target="_blank" rel="noopener">
              <SocialIcon name="youtube" size={22} />
              유튜브 채널 바로가기
            </a>
          )}
        </div>
      ) : (
        <div class="stack">
          <VideoCard video={main} class="main" />

          {rest.length > 0 && (
            <div class="slider" data-slider data-autoplay="5000" aria-roledescription="carousel" aria-label="다른 공연 영상">
              <div class="track" data-track tabindex="0">
                {rest.map((v) => (
                  <div class="slide">
                    <VideoCard video={v} />
                  </div>
                ))}
              </div>

              <div class="slider-controls">
                <button class="slider-nav" type="button" data-prev aria-label="이전 영상">
                  <span aria-hidden="true">‹</span>
                </button>
                <div class="slider-dots" data-dots role="group" aria-label="영상 페이지" />
                <button class="slider-nav" type="button" data-next aria-label="다음 영상">
                  <span aria-hidden="true">›</span>
                </button>
              </div>
            </div>
          )}

          {shorts.length > 0 && (
            <div class="shorts">
              <div class="sub-head">
                <h3>Shorts</h3>
                <p>인스타그램 릴스와 유튜브 쇼츠에 올린 짧은 영상</p>
              </div>
              <div class="slider" data-slider aria-roledescription="carousel" aria-label="쇼츠 영상">
                <div class="track" data-track tabindex="0">
                  {shorts.map((v) => (
                    <div class="slide">
                      <VideoCard video={v} vertical />
                    </div>
                  ))}
                </div>
                <div class="slider-controls">
                  <button class="slider-nav" type="button" data-prev aria-label="이전 쇼츠">
                    <span aria-hidden="true">‹</span>
                  </button>
                  <div class="slider-dots" data-dots role="group" aria-label="쇼츠 페이지" />
                  <button class="slider-nav" type="button" data-next aria-label="다음 쇼츠">
                    <span aria-hidden="true">›</span>
                  </button>
                </div>
              </div>
            </div>
          )}
        </div>
      )
    }

    {
      links.youtube && main && (
        <p class="more">
          <a class="btn btn--ghost yt-link" href={links.youtube} target="_blank" rel="noopener">
            <SocialIcon name="youtube" size={22} />
            유튜브에서 더 보기
          </a>
        </p>
      )
    }
  </div>
</section>

<script>
  import { initSliders } from '../scripts/slider';
  initSliders();
</script>

<style>
  .stack {
    display: grid;
    gap: clamp(28px, 4vw, 44px);
  }

  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - var(--slide-gap)) / 2);
    --slide-gap: clamp(16px, 2.4vw, 28px);
    column-gap: var(--slide-gap);
  }

  .shorts {
    display: grid;
    gap: 16px;
    margin-top: clamp(16px, 3vw, 32px);
  }
  .sub-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
  }
  .sub-head h3 {
    font-size: var(--step-2);
    font-weight: 700;
  }
  .sub-head p {
    color: var(--muted);
    font-size: 0.92rem;
  }
  /* 쇼츠는 한 줄에 4개(휴대폰 2개) */
  .shorts .track {
    grid-auto-columns: calc((100% - 3 * var(--slide-gap)) / 4);
  }
  .shorts :global(figcaption) {
    font-size: 0.92rem;
  }
  .more {
    margin-top: clamp(32px, 4vw, 44px);
    display: flex;
    justify-content: center;
  }
  .yt-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .pending a {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    /* 휴대폰은 한 개씩, 다음 영상이 살짝 보이게 */
    .track {
      grid-auto-columns: 86%;
    }
    .shorts .track {
      grid-auto-columns: calc((100% - var(--slide-gap)) / 2.2);
    }
  }
</style>
