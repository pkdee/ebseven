---
import SocialIcon from './SocialIcon.astro';
import { site, links } from '../data/site';

const socials = [
  links.youtube && { label: 'ebseven 유튜브 채널', href: links.youtube, icon: 'youtube' },
  links.instagram && { label: 'ebseven 인스타그램', href: links.instagram, icon: 'instagram' },
].filter(Boolean) as { label: string; href: string; icon: 'youtube' | 'instagram' }[];

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container grid">
    <div class="brand">
      <img class="logo" src="/images/logo-wordmark.png" alt={site.name} width="749" height="145" loading="lazy" />
      <p class="tag">{site.name} · {site.nameKo}</p>
      <p class="tag">{site.tagline}</p>
    </div>

    {
      socials.length > 0 && (
        <nav class="socials" aria-label="SNS">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
              <SocialIcon name={s.icon} size={32} />
            </a>
          ))}
        </nav>
      )
    }

    <p class="copy">© {year} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface);
    border-top: 1px solid var(--line);
    color: var(--hero-ink);
    padding-block: 64px calc(32px + env(safe-area-inset-bottom, 0px));
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 40px;
  }
  .brand {
    display: grid;
    gap: 4px;
    align-content: start;
  }
  .logo {
    width: 180px;
    height: auto;
    margin-bottom: 10px;
  }
  .tag {
    color: var(--hero-muted);
  }
  .socials {
    display: flex;
    gap: 16px;
    align-items: center;
    align-self: start;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .socials a:hover {
    background: var(--bg);
    transform: translateY(-2px);
  }
  .copy {
    grid-column: 1 / -1;
    font-size: var(--step--1);
    color: var(--hero-muted);
    padding-top: 24px;
    border-top: 1px solid var(--hero-line);
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
