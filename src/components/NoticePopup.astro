---
/**
 * 사이트에 들어오면 뜨는 알림창 (지금은 1집 앨범 커버).
 * 내용은 src/data/site.ts 의 popup 에서 고친다.
 */
import { popup } from '../data/site';
---

{
  popup && (
    <dialog class="notice" data-notice={popup.id} aria-label="새 소식" tabindex="-1">
      <div class="card">
        <a class="art" href={popup.href} data-notice-go>
          <img src={popup.image} alt={popup.alt} width="1000" height="1000" decoding="async" />
        </a>
        {popup.title && (
          <div class="info">
            {popup.label && <p class="label">{popup.label}</p>}
            <p class="title">
              {popup.title}
              {popup.titleEn && <span>{popup.titleEn}</span>}
            </p>
          </div>
        )}
        <div class="actions">
          <button type="button" class="never" data-notice-never>
            7일간 보지 않기
          </button>
          <button type="button" class="close" data-notice-close>
            닫기
          </button>
        </div>
      </div>
    </dialog>
  )
}

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog[data-notice]');
  if (dialog) {
    // "7일간 보지 않기"를 누르면 그때부터 7일 뒤 시각을 남긴다. 그 시각이 지나면 다시 뜬다.
    // "닫기"는 아무것도 남기지 않아 다음에 들어오면 다시 뜬다.
    const HIDE_DAYS = 7;
    const hideKey = `ebseven-notice-hide-until:${dialog.dataset.notice}`;
    // 사생활 보호 모드 등에서는 저장소가 막혀 있을 수 있다. 그때는 그냥 매번 보여 준다.
    let hidden = false;
    try {
      hidden = Date.now() < Number(window.localStorage.getItem(hideKey) || 0);
    } catch {
      /* 읽지 못하면 보여 준다 */
    }

    if (!hidden) {
      // 첫 화면이 그려진 뒤 살짝 늦게 띄운다.
      // 브라우저는 창을 열면 안쪽 첫 버튼이나 링크에 포커스를 줘 테두리가 생길 수 있다.
      // 창 자체로 포커스를 옮겨 아무것도 선택된 것처럼 보이지 않게 한다. Tab 을 누르면 커버부터 차례로 이동한다.
      window.setTimeout(() => {
        dialog.showModal();
        dialog.focus();
      }, 400);
    }

    const close = () => {
      if (dialog.open) dialog.close();
    };
    dialog.querySelector('[data-notice-never]')!.addEventListener('click', () => {
      try {
        window.localStorage.setItem(hideKey, String(Date.now() + HIDE_DAYS * 24 * 60 * 60 * 1000));
      } catch {
        /* 저장하지 못해도 창은 닫힌다 */
      }
      close();
    });
    dialog.querySelector('[data-notice-close]')!.addEventListener('click', close);
    // 바깥 어두운 곳을 누르면 닫는다 (Esc 는 브라우저가 알아서 닫는다)
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });
    // 커버를 누르면 창을 닫고 앨범 소개로 이동한다
    dialog.querySelector('[data-notice-go]')!.addEventListener('click', close);
  }
</script>

<style>
  .notice {
    outline: none;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
    max-width: calc(100vw - 32px);
    max-height: calc(100dvh - 32px);
  }
  .notice::backdrop {
    background: rgba(1, 11, 9, 0.55);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
  .notice[open] .card {
    animation: pop 0.28s cubic-bezier(0.2, 1.4, 0.4, 1);
  }
  .notice[open]::backdrop {
    animation: fade 0.2s ease;
  }
  @keyframes pop {
    from {
      transform: translateY(12px) scale(0.94);
      opacity: 0;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  /* 정사각형 커버 아래에 앨범 이름과 버튼 두 개가 붙은 카드.
     화면이 낮으면 커버(카드 폭)가 줄어들어 버튼까지 한 화면에 들어온다 */
  .card {
    width: min(420px, calc(100vw - 32px), calc(100dvh - 32px - 150px));
    overflow: hidden;
    background: var(--bg);
    border: 2px solid var(--brand-shadow);
    border-radius: 18px;
  }
  .art {
    display: block;
  }
  .art img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .info {
    display: grid;
    gap: 2px;
    padding: 14px 18px 16px;
    border-top: 2px solid var(--brand-shadow);
  }
  .label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--muted);
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 10px;
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .title span {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--accent);
  }
  .actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 2px solid var(--brand-shadow);
  }
  .actions button {
    min-height: 52px;
    padding: 0 12px;
    border: 0;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .actions .never {
    background: var(--bg);
    color: var(--muted);
    border-right: 2px solid var(--brand-shadow);
  }
  .never:hover {
    background: var(--surface);
    color: var(--ink);
  }
  .close {
    background: var(--brand-yellow);
    color: var(--brand-shadow);
  }
  .close:hover {
    background: #ffd766;
  }
  .actions button:focus-visible {
    outline: 3px solid var(--brand-teal);
    outline-offset: -3px;
  }
</style>
